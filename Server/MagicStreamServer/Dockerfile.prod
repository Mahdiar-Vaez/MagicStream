FROM golang:1.24.2-alpine AS build

RUN apk add --no-cache git
ENV GOPROXY=https://proxy.golang.org|direct

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/magicstream-api .

FROM alpine:3.21

RUN apk add --no-cache ca-certificates \
    && addgroup -S app \
    && adduser -S app -G app

COPY --from=build /out/magicstream-api /usr/local/bin/magicstream-api

USER app
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/magicstream-api"]
