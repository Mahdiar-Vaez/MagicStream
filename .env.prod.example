# ============================================================
# MagicStream — Production Environment Variables (.env.prod)
# ============================================================
# این فایل را به .env.prod کپی کن و مقادیر را بر اساس سرور تنظیم کن.
# هرگز .env.prod را commit نکن یا در گیت نگذار.
#
#   Linux:       cp .env.prod.example .env.prod
#   PowerShell:  Copy-Item .env.prod.example .env.prod
#
# دستور اجرا روی سرور:
#   docker compose --env-file .env.prod -f docker-compose.prod.yaml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yaml up -d --remove-orphans
# ============================================================


# ------------------------------------------------------------
# پورت‌های سرور (Host Ports)
# ------------------------------------------------------------
# پورت دسترسی به کلاینت (فرانت‌اند):
# چون پورت ۸۰ سرور به سایت دیگری اختصاص دارد، از یک پورت آزاد مثل ۳۰۰۰ استفاده کن:
# آدرس دسترسی: http://parva-ai.ir:3000  یا  http://156.241.0.153:3000
PROD_CLIENT_PORT=3000

# پورت مستقیم API (اختیاری — فرانت‌اند از طریق پروکسی داخلی /api به این وصل می‌شود):
PROD_API_PORT=8080


# ------------------------------------------------------------
# CORS — مبدأ‌های مجاز
# ------------------------------------------------------------
# آدرس فرانت‌اند را با پورت بنویس (یا * بگذار تا به هر دو IP و دامنه پاسخ دهد):
# مثال: http://parva-ai.ir:3000,http://156.241.0.153:3000
PROD_ALLOWED_ORIGINS=*


# ------------------------------------------------------------
# امنیت کوکی‌ها (Cookie Security)
# ------------------------------------------------------------
# چون تست روی HTTP (بدون HTTPS/SSL) و روی پورت انجام می‌شود، باید false باشد
# تا مرورگرها (Chrome/Firefox) کوکی توکن ورود را مسدود نکنند.
# اگر در آینده دامنه دارای گواهی SSL و HTTPS شد، مقدار را true بگذار.
COOKIE_SECURE=false


# ------------------------------------------------------------
# JWT Secret Keys — کلیدهای امنیتی توکن‌ها
# ------------------------------------------------------------
# حتماً دو مقدار متفاوت، تصادفی و قوی (حداقل ۳۲ کاراکتر) قرار بده:
# تولید در لینوکس:  openssl rand -hex 32
PROD_SECRET_KEY=replace-with-a-long-random-secret
PROD_SECRET_REFRESH_KEY=replace-with-a-different-long-random-secret


# ------------------------------------------------------------
# OpenAI — پیشنهاد هوشمند فیلم (اختیاری)
# ------------------------------------------------------------
# اگر کلید نداری، خالی بگذار؛ برنامه بدون هوش مصنوعی هم به درستی کار می‌کند:
OPENAI_API_KEY=
BASE_PROMPT_TEMPLATE=
RECOMMENDED_MOVIE_LIMIT=5
