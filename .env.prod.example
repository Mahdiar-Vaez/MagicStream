# ============================================================
# MagicStream — Production Environment Variables
# ============================================================
# این فایل را به .env.prod کپی کن و مقادیر واقعی را جایگزین کن.
# هرگز .env.prod را commit نکن یا به Docker Hub push نکن.
#
#   Linux/Mac:   cp .env.prod.example .env.prod
#   PowerShell:  Copy-Item .env.prod.example .env.prod
#
# برای اجرا:
#   docker compose --env-file .env.prod -f docker-compose.prod.yaml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yaml up -d --remove-orphans
# ============================================================


# ------------------------------------------------------------
# پورت‌های expose‌شده روی سرور (host ports)
# ------------------------------------------------------------
# کلاینت (Nginx) روی این پورت در دسترس است → http://parva-ai.ir
PROD_CLIENT_PORT=80

# API (Go/gin) روی این پورت در دسترس است → http://parva-ai.ir:8080
PROD_API_PORT=8080


# ------------------------------------------------------------
# CORS — Origin مجاز برای درخواست‌های API
# ------------------------------------------------------------
# دقیقاً همان آدرسی که مرورگر کاربر با آن وارد می‌شود
PROD_ALLOWED_ORIGINS=http://parva-ai.ir


# ------------------------------------------------------------
# JWT Secret Keys — کلیدهای امضای توکن
# ------------------------------------------------------------
# ⚠️  این دو مقدار باید متفاوت، تصادفی و حداقل ۳۲ کاراکتر باشند
# تولید کلید امن روی لینوکس:  openssl rand -hex 32
PROD_SECRET_KEY=replace-with-a-long-random-secret
PROD_SECRET_REFRESH_KEY=replace-with-a-different-long-random-secret


# ------------------------------------------------------------
# OpenAI — سرویس پیشنهاد فیلم (اختیاری)
# ------------------------------------------------------------
OPENAI_API_KEY=
BASE_PROMPT_TEMPLATE=
RECOMMENDED_MOVIE_LIMIT=5


# ------------------------------------------------------------
# ⚠️  نکته مهم: VITE_API_BASE_URL اینجا نیست!
# ------------------------------------------------------------
# VITE_API_BASE_URL یک Build-time argument است، نه Runtime env var.
# Vite آن را داخل JavaScript کامپایل‌شده می‌گذارد.
# برای این سرور مقدار صحیح است: http://parva-ai.ir:8080
#
# برای rebuild:
#   cd Client/magic-stream-client
#   docker build -f Dockerfile.prod \
#     --build-arg VITE_API_BASE_URL=http://parva-ai.ir:8080 \
#     -t 20071386/magic-stream-client:1.0.0 .
#   docker push 20071386/magic-stream-client:1.0.0
# ------------------------------------------------------------
